{
  "name": "@ice-ai/protocol",
  "description": "PiBoat single contract between front end and back end: API types + event wire format (reuses SDK types + Zod input schemas, zero business logic)",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "~1.0.2",
    "@earendil-works/pi-coding-agent": "~1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@ice-ai/typescript-config": "workspace:*",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
