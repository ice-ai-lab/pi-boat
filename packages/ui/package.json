{
  "name": "@ice-ai/ui",
  "description": "PiBoat 纯展示组件库（只依赖 protocol 类型与 client hooks，不依赖任何宿主框架）",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ice-ai/client": "workspace:*",
    "@ice-ai/protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@ice-ai/typescript-config": "workspace:*",
    "@types/react": "^19",
    "react": "^19.3.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
