{
  "name": "@pi-boat/client",
  "description": "PiBoat 类型安全 client SDK + React hooks（框架无关核心 + client/react 子导出）",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pi-boat/protocol": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@pi-boat/typescript-config": "workspace:*",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
