{
  "name": "@ice-ai/core",
  "description": "PiBoat Agent 业务核心（全仓唯一允许依赖 pi-coding-agent SDK 的包，传输无关）",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "demo:chat": "tsx demo/chat.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "~0.87.1",
    "@earendil-works/pi-coding-agent": "~0.87.1",
    "@ice-ai/protocol": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@ice-ai/typescript-config": "workspace:*",
    "@types/node": "^22",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
