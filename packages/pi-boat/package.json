{
  "name": "@ice-ai/pi-boat",
  "version": "1.3.3",
  "description": "PiBoat — the ship that carries pi: a local AI coding assistant built on the pi-coding-agent SDK. One command to start, use it in your browser (one core, many front ends; the web front end ships today).",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "ai",
    "coding-agent",
    "assistant",
    "web-ui",
    "local"
  ],
  "type": "module",
  "bin": {
    "pi-boat": "dist/pi-boat.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "start": "node dist/pi-boat.mjs",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "~1.0.2",
    "@earendil-works/pi-coding-agent": "~1.0.2",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@ice-ai/protocol": "workspace:*",
    "@ice-ai/server": "workspace:*",
    "@ice-ai/typescript-config": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
